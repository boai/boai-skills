{
  "openapi": "3.0.3",
  "info": {
    "title": "Demo Vehicle API（虚构示例）",
    "version": "1.0.0",
    "description": "仅用于 Skill 演示，接口与数据均为虚构。"
  },
  "servers": [
    { "url": "https://api.example.com" }
  ],
  "paths": {
    "/v1/vehicles": {
      "get": {
        "operationId": "listVehicles",
        "summary": "获取车辆列表",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["online", "offline"] }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VehicleListResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/vehicles/{vehicleId}": {
      "get": {
        "operationId": "getVehicle",
        "summary": "获取车辆详情",
        "parameters": [
          {
            "name": "vehicleId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Vehicle" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VehicleListResponse": {
        "type": "object",
        "required": ["items", "total", "page"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Vehicle" }
          },
          "total": { "type": "integer" },
          "page": { "type": "integer" },
          "has_more": { "type": "boolean" }
        }
      },
      "Vehicle": {
        "type": "object",
        "required": ["id", "name", "plate_number", "status", "battery_level"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "example": "我的爱车" },
          "plate_number": { "type": "string", "example": "粤A·00000" },
          "battery_level": { "type": "integer", "format": "int32" },
          "status": {
            "type": "string",
            "enum": ["online", "offline", "charging"]
          },
          "climate": { "$ref": "#/components/schemas/ClimateState" },
          "owner": { "$ref": "#/components/schemas/User" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "created_at": { "type": "string", "format": "date-time" },
          "last_location": {
            "type": "object",
            "properties": {
              "latitude": { "type": "number", "format": "double" },
              "longitude": { "type": "number", "format": "double" }
            }
          }
        }
      },
      "ClimateState": {
        "type": "object",
        "required": ["is_on"],
        "properties": {
          "is_on": { "type": "boolean" },
          "temperature": { "type": "integer", "nullable": true },
          "mode": {
            "type": "string",
            "enum": ["cool", "heat", "auto"]
          }
        }
      },
      "User": {
        "type": "object",
        "required": ["id", "nickname"],
        "properties": {
          "id": { "type": "string" },
          "nickname": { "type": "string" },
          "phone": { "type": "string", "nullable": true }
        }
      },
      "ElectricVehicle": {
        "allOf": [
          { "$ref": "#/components/schemas/Vehicle" },
          {
            "type": "object",
            "required": ["battery_capacity_kwh"],
            "properties": {
              "battery_capacity_kwh": { "type": "number" },
              "charging_power_kw": { "type": "number", "nullable": true }
            }
          }
        ]
      }
    }
  }
}
